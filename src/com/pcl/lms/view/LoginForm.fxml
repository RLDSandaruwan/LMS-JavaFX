<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="context" prefHeight="480.0" prefWidth="400.0" style="-fx-background-color: #f7f7f7;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pcl.lms.controller.LoginFormController">
    <children>
        <Button onAction="#backToHomeOnAction" prefHeight="32.0" prefWidth="134.0" style="-fx-background-color: #4CAF50; -fx-background-radius: 5;" text="← Back to Home" textFill="WHITE" AnchorPane.leftAnchor="15.0" AnchorPane.topAnchor="15.0">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Button>

        <VBox alignment="CENTER" maxWidth="350.0" spacing="15.0" AnchorPane.bottomAnchor="80.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="60.0">

            <Label text="LMS Login" textFill="#2d3436">
                <font>
                    <Font name="System Bold" size="28.0" />
                </font>
            </Label>
            <Label alignment="CENTER" contentDisplay="CENTER" text="Insert your credentials to access the Learning Management System" textAlignment="CENTER" textFill="#6c757d" wrapText="true">
                <font>
                    <Font size="14.0" />
                </font>
            </Label>

            <VBox prefHeight="10.0" />

            <TextField fx:id="txtEmail" prefHeight="45.0" promptText="Email Address" style="-fx-background-color: white; -fx-border-color: #ced4da; -fx-border-radius: 5; -fx-background-radius: 5;" />
            <PasswordField fx:id="txtPassword" prefHeight="45.0" promptText="Password" style="-fx-background-color: white; -fx-border-color: #ced4da; -fx-border-radius: 5; -fx-background-radius: 5;" />

            <Button maxWidth="1.7976931348623157E308" onAction="#navigateDashboardOnAction" prefHeight="50.0" style="-fx-background-color: #007bff; -fx-background-radius: 5;" text="Log In" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Button>

            <Hyperlink onAction="#navigateForgotPasswordOnAction" style="-fx-text-fill: #007bff;" text="Forgot Password?" underline="true" />

        </VBox>

        <HBox alignment="CENTER" spacing="10" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0">
            <Label fx:id="lblCompany" text="© Company Name" textFill="#999999" />
            <Label text="|" textFill="#999999" />
            <Label fx:id="lblVersion" text="v1.0" textFill="#999999" />
        </HBox>
    </children>
</AnchorPane>
