<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="context" prefHeight="480.0" prefWidth="400.0" style="-fx-background-color: #f7f7f7;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pcl.lms.controller.EmailVerificationFormController">

    <children>

        <!-- Back to Home Button -->
        <Button onAction="#navigateLoginFormOnAction"
                prefHeight="32.0" prefWidth="134.0"
                style="-fx-background-color: #4CAF50; -fx-background-radius: 5;"
                text="← Back to Home" textFill="WHITE"
                AnchorPane.leftAnchor="15.0" AnchorPane.topAnchor="15.0">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Button>

        <!-- Center Content -->
        <VBox alignment="CENTER" spacing="15.0"
              AnchorPane.topAnchor="60.0"
              AnchorPane.bottomAnchor="80.0"
              AnchorPane.leftAnchor="25.0"
              AnchorPane.rightAnchor="25.0">

            <!-- Title -->
            <Label text="Forgot Password" textFill="#2d3436">
                <font>
                    <Font name="System Bold" size="26.0" />
                </font>
            </Label>

            <!-- Subtitle -->
            <Label alignment="CENTER" textAlignment="CENTER"
                   text="Enter your registered email address to receive a verification code."
                   textFill="#6c757d" wrapText="true">
                <font>
                    <Font size="14.0" />
                </font>
            </Label>

            <!-- Space -->
            <VBox prefHeight="10.0" />

            <!-- Email Input -->
            <TextField fx:id="txtEmail"
                       prefHeight="45.0"
                       promptText="Email Address"
                       style="-fx-background-color: white; -fx-border-color: #ced4da; -fx-border-radius: 5; -fx-background-radius: 5;" />

            <!-- Send Code Button -->
            <Button maxWidth="1.7976931348623157E308"
                    onAction="#navigateVerifyCodeOnAction"
                    prefHeight="50.0"
                    style="-fx-background-color: #007bff; -fx-background-radius: 5;"
                    text="Send Verification Code"
                    textFill="WHITE">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Button>

        </VBox>

        <!-- Footer -->
        <HBox alignment="CENTER" spacing="10"
              AnchorPane.bottomAnchor="15.0"
              AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0">
            <Label fx:id="lblCompany" text="© Company Name" textFill="#999999" />
            <Label text="|" textFill="#999999" />
            <Label fx:id="lblVersion" text="v1.0" textFill="#999999" />
        </HBox>

    </children>
</AnchorPane>
